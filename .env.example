MONGODB_URI=mongodb://localhost:27017/finance-planner
JWT_SECRET=change-me-to-a-long-random-string
# Optional dedicated key for account fields, OpenAI API keys, and forwarded SMS (falls back to JWT_SECRET)
ENCRYPTION_KEY=
# Must be the public HTTPS origin for the Android SMS webhook setup screen in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# S3-compatible object storage (AWS S3, Cloudflare R2, Hetzner Object Storage)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
